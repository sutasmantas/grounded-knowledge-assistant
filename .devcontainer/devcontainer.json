{
  "name": "Atlas Knowledge",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "containerEnv": {
    "ATLAS_EMBEDDING_PROVIDER": "hash",
    "ATLAS_GENERATION_PROVIDER": "extractive"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e '.[dev]'",
  "postStartCommand": "nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/atlas.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Atlas Knowledge",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
