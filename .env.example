ATLAS_DATA_DIR=data/runtime
ATLAS_EMBEDDING_PROVIDER=fastembed
ATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only needed for the optional hosted embedding profile:
# ATLAS_EMBEDDING_PROVIDER=openai-compatible
# ATLAS_EMBEDDING_MODEL=text-embedding-3-large
# ATLAS_EMBEDDING_DIMENSIONS=1024
# ATLAS_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ATLAS_EMBEDDING_API_KEY=
ATLAS_RETRIEVAL_PROFILE=sparse
ATLAS_RETRIEVAL_CANDIDATE_K=24
ATLAS_RERANKER_PROVIDER=cross-encoder
ATLAS_RERANKER_MODEL=BAAI/bge-reranker-base
ATLAS_CHUNKING_PROFILE=fixed
ATLAS_GENERATION_PROVIDER=extractive
ATLAS_INGESTION_WORKER_ENABLED=true
ATLAS_INGESTION_WORKER_POLL_SECONDS=0.5
ATLAS_INGESTION_JOB_MAX_ATTEMPTS=3
ATLAS_OTEL_EXPORTER_OTLP_ENDPOINT=
ATLAS_OTEL_SERVICE_NAME=atlas-knowledge
ATLAS_STRUCTURED_LOGS=true
ATLAS_REQUEST_BODY_LIMIT_MB=12
# Keep `embedded` for the no-service demo. For server mode set both values.
ATLAS_QDRANT_MODE=embedded
ATLAS_QDRANT_URL=
ATLAS_QDRANT_API_KEY=
ATLAS_QDRANT_TIMEOUT_SECONDS=5
# `headers` is the runnable no-key demo. Use `oidc` at an untrusted edge.
ATLAS_AUTH_MODE=headers
ATLAS_OIDC_ISSUER=
ATLAS_OIDC_AUDIENCE=
ATLAS_OIDC_JWKS_URL=
ATLAS_OIDC_ALGORITHMS=["RS256"]
ATLAS_OIDC_TENANT_CLAIM=tenant_id
ATLAS_OIDC_PRINCIPAL_CLAIM=sub
ATLAS_OIDC_GROUPS_CLAIM=groups
ATLAS_OIDC_ROLES_CLAIM=roles
ATLAS_OIDC_JWKS_CACHE_SECONDS=300
ATLAS_OIDC_JWKS_TIMEOUT_SECONDS=5
ATLAS_OIDC_CLOCK_SKEW_SECONDS=30
ATLAS_LLM_BASE_URL=
ATLAS_LLM_API_KEY=
ATLAS_LLM_MODEL=
ATLAS_LLM_MAX_TOKENS=256
ATLAS_MAX_UPLOAD_MB=10
ATLAS_PDF_MIN_CHARACTERS_PER_PAGE=24
# Named local connector roots. Only these directories can ever be synchronized,
# and requests select them by name, never by absolute path.
# ATLAS_CONNECTOR_LOCAL_ROOTS={"handbook": "/srv/atlas/handbook"}
ATLAS_CONNECTOR_MAX_ITEMS=500
ATLAS_CONNECTOR_MAX_DOCUMENT_MB=10
ATLAS_CONNECTOR_URL_TIMEOUT_SECONDS=10
ATLAS_CONNECTOR_URL_MAX_REDIRECTS=3
# Leave false unless an operator has decided that internal hosts may be indexed.
# Cloud metadata addresses stay blocked in either mode.
ATLAS_CONNECTOR_URL_ALLOW_PRIVATE_NETWORKS=false
# archive keeps the version history and removes every retrieval representation.
ATLAS_CONNECTOR_DELETION_POLICY=archive
ATLAS_TOP_K=5
ATLAS_MIN_SCORE=0.08
ATLAS_SEMANTIC_EVIDENCE_FLOOR=0.50
ATLAS_SCORE_RATIO=0.90
